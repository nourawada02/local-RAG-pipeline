{
  "experiment_id": "ocr_fallback",
  "independent_variable": "document extraction",
  "corpus": "rag-evaluation-starter\\data\\corpus",
  "collection_name": "university_documents",
  "chunking": "RecursiveCharacterTextSplitter",
  "chunk_size_characters": 1000,
  "chunk_overlap_characters": 200,
  "embedding_model": "mxbai-embed-large",
  "embedding_batch_size": 16,
  "retrieval": "dense cosine similarity",
  "top_k": 3,
  "generation_model": "qwen3.5:2b",
  "temperature": 0.2,
  "num_ctx": 4096,
  "num_predict": 256,
  "reasoning": false,
  "ocr": {
    "enabled": true,
    "strategy": "fallback only when native extraction is empty",
    "engine": "Tesseract",
    "engine_version": "5.4.0.20240606",
    "language": "eng",
    "render_dpi": 300,
    "config": "--oem 1 --psm 3"
  }
}
